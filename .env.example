# Common
TTS_OUTPUT_FORMAT=mp3
TTS_REFERENCE_VIDEO=ref_japanese.mp4
DEFAULT_TTS_PROVIDER=elevenlabs
SERVICE_OUTPUT_DIR=outputs/service

# Telegram polling service
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user IDs allowed to use the bot. Leave empty only
# for local testing.
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_MAX_TEXT_LENGTH=2000
TELEGRAM_DEBUG_REPLY_JSON=false

# Gemini dialogue normalizer
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ENABLE_GEMINI_DIALOGUE_PARSER=true

# Google Cloud Text-to-Speech
# Auth uses Application Default Credentials:
#   gcloud auth application-default login
# or GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
GOOGLE_TTS_VOICE=ja-JP-Chirp3-HD-Aoede

# Azure AI Speech
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=japaneast
AZURE_TTS_VOICE=ja-JP-KeitaNeural

# ElevenLabs
ELEVENLABS_API_KEY=
# Must be one of eleven_flash_v2_5 or eleven_turbo_v2_5 for this arena.
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5
# Optional: use this existing voice directly. It can be a default/library voice
# or a cloned voice. If empty and cloning is disabled, the first available voice
# in your ElevenLabs account is used.
ELEVENLABS_VOICE_ID=
# Second voice for two-person dialogue. Speaker A uses ELEVENLABS_VOICE_ID,
# speaker B uses ELEVENLABS_VOICE_ID2.
ELEVENLABS_VOICE_ID2=
# Set true only when you want to create an Instant Voice Clone from ref_japanese.mp4.
ELEVENLABS_ENABLE_CLONING=false
ELEVENLABS_CLONE_NAME=ja-ref-arena

# OpenAI
OPENAI_API_KEY=
OPENAI_TTS_MODEL=tts-1-hd
OPENAI_TTS_VOICE=alloy

# GPT-SoVITS local API on your Ubuntu/3060 Ti host.
GPT_SOVITS_BASE_URL=http://192.168.1.50:9880
GPT_SOVITS_CKPT_PATH=
# Optional remote path on the Ubuntu GPT-SoVITS host. Use this if the API
# expects ref_audio_path to point to a file already present on that server.
GPT_SOVITS_REF_AUDIO_PATH=
GPT_SOVITS_MODEL_ENDPOINT=/set_model
GPT_SOVITS_TTS_ENDPOINT=/tts

# VideoSRT Agent integration (watch_dir pattern)
# Set both to enable automatic bilingual subtitle generation after TTS.
# Telegram bot will send the _bi.srt back to the user when ready.
VIDEOSRT_WATCH_DIR=
VIDEOSRT_OUT_DIR=
# Maximum seconds to wait for subtitle generation (default 600)
VIDEOSRT_TIMEOUT=600
